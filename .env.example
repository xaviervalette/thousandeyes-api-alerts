# Token OAuth ThousandEyes (Account Settings > Users and Roles > User API Tokens
# > Bearer Token). Scopes de lecture suffisants : Alerts (read), Tests (read).
TE_TOKEN=votre_token_ici

# Account Group ID. Optionnel : sans valeur, l'API utilise le groupe de compte
# par defaut du token. Recuperable via GET /v7/account-groups.
# TE_AID=1234

# Surcharges optionnelles
# TE_BASE_URL=https://api.thousandeyes.com/v7
# TE_TIMEOUT=30
# TE_CACHE_TTL=60
